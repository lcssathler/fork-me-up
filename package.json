{
  "name": "fork-me-up",
  "version": "0.0.0",
  "description": "Portable, evidence-bounded developer context for AI tools.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": "11.19.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.19.0",
      "onFail": "error"
    }
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "adapters/*"
  ],
  "scripts": {
    "format": "prettier --write \"**/*.{json,jsonc,yaml,yml,js,cjs,mjs,ts,cts,mts}\"",
    "format:check": "prettier --check \"**/*.{json,jsonc,yaml,yml,js,cjs,mjs,ts,cts,mts}\"",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "node scripts/run-test-suite.mjs unit",
    "test:integration": "node scripts/run-test-suite.mjs integration",
    "eval": "node scripts/run-test-suite.mjs eval",
    "check": "node scripts/run-checks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  }
}

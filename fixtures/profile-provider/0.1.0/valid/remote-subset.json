{
  "schemaVersion": "0.1.0",
  "kind": "profile-provider-capabilities",
  "providerId": "provider_synthetic_remote",
  "protocolVersions": ["0.1.0"],
  "operations": ["get-provider-capabilities", "get-task-context"],
  "sourceClasses": ["selected-public-repository", "selected-private-repository"],
  "disclosureClasses": ["task-context", "consumer-session"],
  "deployment": "remote-managed",
  "limits": {
    "maxTaskBytes": 2048,
    "maxOutputBytes": 16384,
    "maxOutputTokens": 2048,
    "maxRequestedCapabilities": 16
  },
  "freshnessSupport": {
    "partialResults": true,
    "staleResults": false
  }
}

{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "adapters/**/*.ts",
    "apps/**/*.ts",
    "consumers/**/*.mjs",
    "eslint.config.mjs",
    "packages/**/*.ts",
    "scripts/**/*.mjs",
    "tests/**/*.mjs"
  ],
  "exclude": ["build", "coverage", "dist", "node_modules"]
}

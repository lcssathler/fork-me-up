{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fork-me-up:dcp:0.1.0",
  "title": "Developer Context Packet 0.1.0 (unreleased authoring draft)",
  "description": "Exact producer shape only. Structural validation is not authorization, redaction, attribution, task relevance, or consumer conformance. Free text has no instruction authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packetId",
    "profileVersion",
    "purpose",
    "audience",
    "task",
    "budget",
    "claims",
    "uncertainties",
    "responsePolicy",
    "provenanceSummary",
    "disclosure",
    "generatedAt",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "packetId": {
      "$ref": "#/$defs/identifier"
    },
    "profileVersion": {
      "$ref": "#/$defs/identifier"
    },
    "purpose": {
      "enum": ["coding-assistance", "technical-learning", "professional-preparation"]
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "consumerId"],
      "properties": {
        "class": {
          "enum": ["local-assistant", "external-consumer"]
        },
        "consumerId": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "class": {
                "const": "external-consumer"
              }
            },
            "required": ["class"]
          },
          "then": {
            "properties": {
              "consumerId": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        }
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "requiredCapabilities"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "requiredCapabilities": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/capability"
          },
          "uniqueItems": true
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxBytes"],
      "properties": {
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        }
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/claimSummary"
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "reason", "material"],
        "properties": {
          "capability": {
            "$ref": "#/$defs/capability"
          },
          "reason": {
            "$ref": "#/$defs/shortText"
          },
          "material": {
            "type": "boolean"
          }
        }
      }
    },
    "responsePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "explainPurposeBeforeCommands",
        "includeExpectedResult",
        "includeRiskAndRollback",
        "analogyCapabilities",
        "questionBudget"
      ],
      "properties": {
        "mode": {
          "enum": ["concise", "analogy", "teach-while-doing"]
        },
        "explainPurposeBeforeCommands": {
          "type": "boolean"
        },
        "includeExpectedResult": {
          "type": "boolean"
        },
        "includeRiskAndRollback": {
          "type": "boolean"
        },
        "analogyCapabilities": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/capability"
          },
          "uniqueItems": true
        },
        "questionBudget": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "provenanceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceCount", "sourceClasses"],
      "properties": {
        "evidenceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "sourceClasses": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/capability"
          },
          "uniqueItems": true
        }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "redactionsApplied"],
      "properties": {
        "class": {
          "enum": ["task-context", "consumer-session"]
        },
        "redactionsApplied": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/capability"
          },
          "uniqueItems": true
        }
      }
    },
    "generatedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "expiresAt": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*(?![\\s\\S])"
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*(?![\\s\\S])"
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z(?![\\s\\S])"
    },
    "claimSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimId",
        "capability",
        "state",
        "observedDepth",
        "confidence",
        "scope",
        "adjacentFrom",
        "evidenceRefs",
        "limitations",
        "freshness"
      ],
      "properties": {
        "claimId": {
          "$ref": "#/$defs/identifier"
        },
        "capability": {
          "$ref": "#/$defs/capability"
        },
        "state": {
          "enum": ["demonstrated", "adjacent", "self-declared", "insufficient-evidence", "disputed"]
        },
        "observedDepth": {
          "enum": [null, "exposure", "practical-use", "demonstrated-depth"]
        },
        "confidence": {
          "enum": ["low", "medium", "high"]
        },
        "scope": {
          "enum": ["global", "project"]
        },
        "adjacentFrom": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/capability"
          },
          "uniqueItems": true
        },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/shortText"
          }
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observedThrough", "stale"],
          "properties": {
            "observedThrough": {
              "anyOf": [
                {
                  "$ref": "#/$defs/timestamp"
                },
                {
                  "type": "null"
                }
              ]
            },
            "stale": {
              "type": "boolean"
            }
          }
        },
        "adjacentRationale": {
          "$ref": "#/$defs/shortText"
        },
        "correctionRef": {
          "$ref": "#/$defs/identifier"
        },
        "correctionSummary": {
          "$ref": "#/$defs/shortText"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "demonstrated"
              }
            },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "observedDepth": {
                "enum": ["exposure", "practical-use", "demonstrated-depth"]
              },
              "evidenceRefs": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": ["insufficient-evidence", "self-declared"]
              }
            },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "observedDepth": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "adjacent"
              }
            },
            "required": ["state"]
          },
          "then": {
            "required": ["adjacentRationale"],
            "properties": {
              "adjacentFrom": {
                "type": "array",
                "minItems": 1
              },
              "observedDepth": {
                "type": "null"
              },
              "adjacentRationale": {
                "$ref": "#/$defs/shortText"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "disputed"
              }
            },
            "required": ["state"]
          },
          "then": {
            "required": ["correctionRef", "correctionSummary"],
            "properties": {
              "correctionRef": {
                "$ref": "#/$defs/identifier"
              },
              "correctionSummary": {
                "$ref": "#/$defs/shortText"
              }
            }
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fork-me-up:internal:community-profile-store:0.1.0",
  "title": "Community Profile Store 0.1.0 (implementation-internal unreleased draft)",
  "description": "Canonical private state for the reference Community provider. It is not an interchange contract, Portable Profile Export, or DCP.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "storeSchemaVersion",
    "kind",
    "storeId",
    "profileVersion",
    "subjectRef",
    "profile",
    "internalState"
  ],
  "properties": {
    "storeSchemaVersion": {
      "const": "0.1.0"
    },
    "kind": {
      "const": "community-profile-store"
    },
    "storeId": {
      "$ref": "#/$defs/identifier"
    },
    "profileVersion": {
      "$ref": "#/$defs/identifier"
    },
    "subjectRef": {
      "$ref": "#/$defs/identifier"
    },
    "profile": {
      "$ref": "urn:fork-me-up:portable-profile-export:0.1.0#/$defs/profilePayload"
    },
    "internalState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "createdAt",
        "updatedAt",
        "lastValidatedAt",
        "migratedFromStoreSchemaVersion"
      ],
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "lastValidatedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "migratedFromStoreSchemaVersion": {
          "anyOf": [
            {
              "$ref": "#/$defs/semanticVersion"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*(?![\\s\\S])"
    },
    "semanticVersion": {
      "type": "string",
      "minLength": 5,
      "maxLength": 32,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z(?![\\s\\S])"
    }
  }
}

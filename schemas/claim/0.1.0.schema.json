{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fork-me-up:claim:0.1.0",
  "title": "Claim 0.1.0 (unreleased authoring draft)",
  "description": "A capability assessment with an explicit state-matched provenance basis. It is not a score, authorization grant, profile export, or DCP.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "claimId",
    "capability",
    "state",
    "observedDepth",
    "confidence",
    "scope",
    "projectRef",
    "basis",
    "limitations",
    "freshness"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "claimId": {
      "$ref": "#/$defs/identifier"
    },
    "capability": {
      "$ref": "#/$defs/capability"
    },
    "state": {
      "enum": ["demonstrated", "adjacent", "self-declared", "insufficient-evidence", "disputed"]
    },
    "observedDepth": {
      "enum": [null, "exposure", "practical-use", "demonstrated-depth"]
    },
    "confidence": {
      "enum": ["low", "medium", "high"]
    },
    "scope": {
      "enum": ["global", "project"]
    },
    "projectRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "evidenceRefs",
        "adjacentFrom",
        "rationale",
        "declarationRef",
        "correctionRef",
        "correctionSummary"
      ],
      "properties": {
        "kind": {
          "enum": ["evidence", "adjacency", "declaration", "insufficient-evidence", "dispute"]
        },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "adjacentFrom": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/capability"
          },
          "uniqueItems": true
        },
        "rationale": {
          "anyOf": [
            {
              "$ref": "#/$defs/shortText"
            },
            {
              "type": "null"
            }
          ]
        },
        "declarationRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "correctionRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "correctionSummary": {
          "anyOf": [
            {
              "$ref": "#/$defs/shortText"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/shortText"
      },
      "uniqueItems": true
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedThrough", "stale"],
      "properties": {
        "observedThrough": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "stale": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "project"
          }
        },
        "required": ["scope"]
      },
      "then": {
        "properties": {
          "projectRef": {
            "$ref": "#/$defs/identifier"
          }
        }
      },
      "else": {
        "properties": {
          "projectRef": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "demonstrated"
          }
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "observedDepth": {
            "enum": ["exposure", "practical-use", "demonstrated-depth"]
          },
          "basis": {
            "$ref": "#/$defs/evidenceBasis"
          },
          "freshness": {
            "$ref": "#/$defs/observedFreshness"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "adjacent"
          }
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "observedDepth": {
            "type": "null"
          },
          "basis": {
            "$ref": "#/$defs/adjacencyBasis"
          },
          "freshness": {
            "$ref": "#/$defs/observedFreshness"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "self-declared"
          }
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "observedDepth": {
            "type": "null"
          },
          "basis": {
            "$ref": "#/$defs/declarationBasis"
          },
          "freshness": {
            "$ref": "#/$defs/unobservedFreshness"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "insufficient-evidence"
          }
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "observedDepth": {
            "type": "null"
          },
          "confidence": {
            "const": "low"
          },
          "basis": {
            "$ref": "#/$defs/insufficientBasis"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "disputed"
          }
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "basis": {
            "$ref": "#/$defs/disputeBasis"
          },
          "freshness": {
            "$ref": "#/$defs/observedFreshness"
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*(?![\\s\\S])"
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*(?![\\s\\S])"
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z(?![\\s\\S])"
    },
    "emptyCapabilities": {
      "type": "array",
      "maxItems": 0
    },
    "emptyEvidenceRefs": {
      "type": "array",
      "maxItems": 0
    },
    "evidenceBasis": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "evidence"
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1
        },
        "adjacentFrom": {
          "$ref": "#/$defs/emptyCapabilities"
        },
        "rationale": {
          "type": "null"
        },
        "declarationRef": {
          "type": "null"
        },
        "correctionRef": {
          "type": "null"
        },
        "correctionSummary": {
          "type": "null"
        }
      }
    },
    "adjacencyBasis": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "adjacency"
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1
        },
        "adjacentFrom": {
          "type": "array",
          "minItems": 1
        },
        "rationale": {
          "$ref": "#/$defs/shortText"
        },
        "declarationRef": {
          "type": "null"
        },
        "correctionRef": {
          "type": "null"
        },
        "correctionSummary": {
          "type": "null"
        }
      }
    },
    "declarationBasis": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "declaration"
        },
        "evidenceRefs": {
          "$ref": "#/$defs/emptyEvidenceRefs"
        },
        "adjacentFrom": {
          "$ref": "#/$defs/emptyCapabilities"
        },
        "rationale": {
          "type": "null"
        },
        "declarationRef": {
          "$ref": "#/$defs/identifier"
        },
        "correctionRef": {
          "type": "null"
        },
        "correctionSummary": {
          "type": "null"
        }
      }
    },
    "insufficientBasis": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "insufficient-evidence"
        },
        "adjacentFrom": {
          "$ref": "#/$defs/emptyCapabilities"
        },
        "rationale": {
          "type": "null"
        },
        "declarationRef": {
          "type": "null"
        },
        "correctionRef": {
          "type": "null"
        },
        "correctionSummary": {
          "type": "null"
        }
      }
    },
    "disputeBasis": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "dispute"
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1
        },
        "adjacentFrom": {
          "$ref": "#/$defs/emptyCapabilities"
        },
        "rationale": {
          "type": "null"
        },
        "declarationRef": {
          "type": "null"
        },
        "correctionRef": {
          "$ref": "#/$defs/identifier"
        },
        "correctionSummary": {
          "$ref": "#/$defs/shortText"
        }
      }
    },
    "observedFreshness": {
      "type": "object",
      "properties": {
        "observedThrough": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "unobservedFreshness": {
      "type": "object",
      "properties": {
        "observedThrough": {
          "type": "null"
        }
      }
    }
  }
}

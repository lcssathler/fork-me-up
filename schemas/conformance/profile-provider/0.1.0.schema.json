{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fork-me-up:conformance:profile-provider:0.1.0",
  "title": "Profile Provider conformance transcript 0.1.0 (unreleased draft)",
  "description": "Synthetic provider/consumer exchange transcript. Structural validity is not runtime, transport, authorization, or client conformance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["conformanceVersion", "kind", "provider", "exchanges"],
  "properties": {
    "conformanceVersion": {
      "const": "0.1.0"
    },
    "kind": {
      "const": "profile-provider-conformance"
    },
    "provider": {
      "$ref": "urn:fork-me-up:profile-provider:0.1.0"
    },
    "exchanges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request", "response"],
        "properties": {
          "request": {
            "$ref": "urn:fork-me-up:profile-provider:0.1.0#/$defs/request"
          },
          "response": {
            "$ref": "urn:fork-me-up:profile-provider:0.1.0#/$defs/response"
          }
        }
      }
    },
    "extensions": {
      "$ref": "urn:fork-me-up:profile-provider:0.1.0#/$defs/extensions"
    }
  }
}

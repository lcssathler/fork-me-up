{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fork-me-up:demand-profile:0.1.0",
  "title": "Demand Profile 0.1.0 (unreleased authoring draft)",
  "description": "Task-scoped project demand. It is not a developer assessment, DCP, authorization grant, repository digest, or instruction channel.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "demandId",
    "project",
    "task",
    "capabilities",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "kind": {
      "const": "demand-profile"
    },
    "demandId": {
      "$ref": "#/$defs/identifier"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectRef", "metadataStatus", "metadataRevisionRef"],
      "properties": {
        "projectRef": {
          "$ref": "#/$defs/identifier"
        },
        "metadataStatus": {
          "enum": ["available", "partial", "unavailable"]
        },
        "metadataRevisionRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "metadataStatus": {
                "const": "available"
              }
            },
            "required": ["metadataStatus"]
          },
          "then": {
            "properties": {
              "metadataRevisionRef": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metadataStatus": {
                "const": "unavailable"
              }
            },
            "required": ["metadataStatus"]
          },
          "then": {
            "properties": {
              "metadataRevisionRef": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "purpose"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "purpose": {
          "enum": ["coding-assistance", "technical-learning", "professional-preparation"]
        }
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/demandCapability"
      }
    },
    "generatedAt": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*(?![\\s\\S])"
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*(?![\\s\\S])"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z(?![\\s\\S])"
    },
    "demandCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "relevance", "basis"],
      "properties": {
        "capability": {
          "$ref": "#/$defs/capability"
        },
        "relevance": {
          "enum": ["required", "supporting"]
        },
        "basis": {
          "enum": ["task-input", "project-metadata", "task-and-project"]
        }
      }
    }
  }
}
